# Google Places API (New) key. Leave empty to use built-in demo restaurants.
GOOGLE_PLACES_API_KEY=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Optional.
NEXT_PUBLIC_GA_ID=
# Google Tag Manager container ID (looks like GTM-XXXXXXX). Optional; use it to add other tracking tags.
NEXT_PUBLIC_GTM_ID=
